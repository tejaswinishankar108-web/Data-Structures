import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

data = {
    'Concept': ['Arrays & Hashing', 'Two Pointers', 'Sliding Window', 'Binary Search', 'Recursion (Basics)',
                'Backtracking', 'Singly Linked List', 'Doubly Linked List', 'Stack & Queue', 'Monotonic Stack',
                'Merge Sort', 'Quick Sort', 'Binary Tree (BFS)', 'Binary Tree (DFS)', 'Binary Search Tree (BST)',
                'Heaps (Priority Queue)', 'Graphs (Adjacency List)', 'Graphs (Dijkstra)', 'Graphs (Topological Sort)',
                'Dynamic Programming (Memoization)', 'Dynamic Programming (Tabulation)', 'Trie (Prefix Tree)',
                'Union Find (Disjoint Set)'],
    'Priority': ['High', 'High', 'High', 'High', 'High', 'Medium', 'High', 'Medium', 'High', 'Medium',
                 'Medium', 'Medium', 'High', 'High', 'High', 'High', 'High', 'Medium', 'Medium', 'High', 'High', 'Low', 'Low'],
    'Status': ['Not Started'] * 23,
    'Theory Read (1 Sentence Summary)': [''] * 23,
    'Pros (Positives)': [''] * 23,
    'Cons (Negatives)': [''] * 23,
    'Leetcode Easy (Q#)': [''] * 23,
    'Leetcode Medium (Q#)': [''] * 23,
    'Leetcode Hard (Q#)': [''] * 23,
    'GitHub Repo Link': [''] * 23,
    'Real-World Use Case 1': [''] * 23,
    'Real-World Use Case 2': [''] * 23,
    'Edge Case 1 (Null/Empty)': [''] * 23,
    'Edge Case 2 (Overflow/Duplicates)': [''] * 23,
    'Edge Case 3 (Off-by-One)': [''] * 23,
    'Time Complexity': [''] * 23,
    'Space Complexity': [''] * 23
}

df = pd.DataFrame(data)
df.to_excel('tracker_professional.xlsx', index=False, sheet_name='tracker')

# Apply formatting
wb = load_workbook('tracker_professional.xlsx')
ws = wb['tracker']

# Define styles
header_font = Font(bold=True, color='FFFFFF', size=11)
header_fill = PatternFill(start_color='1A5276', end_color='1A5276', fill_type='solid')
header_alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
cell_alignment = Alignment(horizontal='left', vertical='center', wrap_text=True)
thin_border = Border(
    left=Side(style='thin', color='D5D8DC'),
    right=Side(style='thin', color='D5D8DC'),
    top=Side(style='thin', color='D5D8DC'),
    bottom=Side(style='thin', color='D5D8DC')
)

# Apply to header row
for col in range(1, ws.max_column + 1):
    cell = ws.cell(row=1, column=col)
    cell.font = header_font
    cell.fill = header_fill
    cell.alignment = header_alignment
    cell.border = thin_border

# Auto-adjust column widths
for col in range(1, ws.max_column + 1):
    max_length = 0
    column_letter = ws.cell(row=1, column=col).column_letter
    for row in range(1, ws.max_row + 1):
        value = ws.cell(row=row, column=col).value
        if value:
            max_length = max(max_length, len(str(value)))
    ws.column_dimensions[column_letter].width = min(max_length + 4, 35)

# Apply alignment and borders to all cells
for row in range(1, ws.max_row + 1):
    for col in range(1, ws.max_column + 1):
        cell = ws.cell(row=row, column=col)
        cell.alignment = cell_alignment
        if row > 1:
            cell.border = thin_border

# Freeze header row
ws.freeze_panes = 'A2'

wb.save('tracker_professional.xlsx')
print("✅ File 'tracker_professional.xlsx' created with professional formatting!")